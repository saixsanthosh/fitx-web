# FITX app (repository root). Copy to .env.local; never commit real values.
# Admin has its own list in admin/.env.example.

# Supabase public client configuration (browser-visible). One of the two keys is enough.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical production origin for sign-in redirects (defaults to https://fitnessx.vercel.app in Vercel Production)
NEXT_PUBLIC_SITE_URL=https://fitnessx.vercel.app
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=false
# Google's own "Sign in with Google" button, so Google's screen names FITX (docs/runbooks/google-sign-in.md).
# The OAuth web client id (…apps.googleusercontent.com, public by design). Unset: the redirect flow as before.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_SITE_VERIFICATION=
# Optional contact details on the landing page; Admin's website information wins, then these, then src/config/brand.ts
NEXT_PUBLIC_FITX_INSTAGRAM_URL=
NEXT_PUBLIC_FITX_CONTACT_EMAIL=

# Server only, never NEXT_PUBLIC_: Supabase secret key for account deletion and billing records.
# On Vercel, set it for Production only: Preview builds use the same Supabase project.
SUPABASE_SECRET_KEY=
# Legacy alternative, only if the project has no secret key. Do not set both.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side food search integrations
# A free api.data.gov key: live USDA FoodData Central search when FITX's own catalogue finds little
USDA_API_KEY=
# Open Food Facts asks for "AppName/Version (contact)"; without a contact, the site URL is added
OPEN_FOOD_FACTS_USER_AGENT=FITX/1.0

# AI coach, server only, free tiers (see docs/runbooks/ai-coach.md): any one key turns the coach on
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Cloudflare Workers AI (Workers Free plan): both are needed; the token alone cannot find its account.
# The account ID is on the Cloudflare dashboard's Workers & Pages overview.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional free tiers. Like Gemini's free tier they may keep or learn from prompts, so by default they get only
# "Questions only" requests; the two *_WITH_MEMBER_DATA switches below opt in (owner's decision, then redeploy).
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Optional: false pauses every AI feature.
AI_COACH_ENABLED=
# Leave unset unless the owner accepts it: lets Gemini's free tier (where people at Google may read prompts)
# answer requests that carry the member's FITX summary or the eating-disorder care note. Unset, Gemini only
# gets requests without them. The privacy page's AI coach section follows it (src/lib/ai/disclosure.ts), so
# redeploy after changing it.
AI_GEMINI_WITH_MEMBER_DATA=
# AI_CEREBRAS_WITH_MEMBER_DATA=
# AI_MISTRAL_WITH_MEMBER_DATA=
# Leave unset: true lets the router use models that are not on a free tier. Never set it without the owner's approval.
# AI_ALLOW_PAID=
# Optional comma-separated model lists replacing the defaults (non-free models are still refused)
# AI_GEMINI_MODELS=
# AI_GROQ_MODELS=
# AI_CLOUDFLARE_MODELS=
# AI_CEREBRAS_MODELS=
# AI_MISTRAL_MODELS=
# AI_OPENROUTER_MODELS=
# Optional: an Ollama server the owner runs and its model name. An https:// address works everywhere;
# a localhost address (http://127.0.0.1:11434) only in local development.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Razorpay subscriptions, server only (see docs/runbooks/billing-razorpay.md): key id, key secret, webhook secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Protects /api/billing/reconcile; Vercel Cron sends it as a Bearer token
CRON_SECRET=
# Test mode only: comma-separated emails allowed to check out with Razorpay test cards
BILLING_TEST_EMAILS=
# Tests only: points the Razorpay client at a local fake (only a loopback http:// address is accepted). Leave unset.
# RAZORPAY_API_BASE=

# Optional activity map styles (full MapLibre style URLs); OpenFreeMap is used when unset
NEXT_PUBLIC_ACTIVITY_MAP_STYLE_LIGHT=
NEXT_PUBLIC_ACTIVITY_MAP_STYLE_DARK=

# Security headers. 1 at build time sends the Content-Security-Policy as report-only again (it is enforced by
# default); headers are fixed at build, so changing it needs a redeploy. Leave unset.
# FITX_CSP_REPORT_ONLY=

# The e2e harness only (tests/e2e/run.mjs sets it): lets a page with the fitx_film_fixture cookie use the tiny
# fixture films. Never set it on Vercel.
# NEXT_PUBLIC_FITX_FILM_FIXTURE=
