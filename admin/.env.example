# Public Supabase client configuration for the existing FITX project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only elevated key. Set one of these in a private local/Vercel environment.
# Prefer the current Supabase secret key; never prefix it with NEXT_PUBLIC_.
# In Vercel: mark it Sensitive and set it for Production only.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative if the current secret key is unavailable.
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Canonical origin. In production every other host redirects here.
# Production: https://fitnessx-admin.vercel.app once that name is added in Vercel
# (until then https://admin-one-blond.vercel.app). Local development: http://localhost:3100
ADMIN_SITE_URL=http://localhost:3100

# The root operator (the owner). The username in lower case, and the single line that
# `npm run admin:hash` prints (it starts scrypt:). Never put the password itself here.
# In Vercel: Production only, marked Sensitive.
FITX_ADMIN_USERNAME=owner-name
FITX_ADMIN_PASSWORD_HASH=scrypt:replace_with_the_line_from_npm_run_admin_hash

# Optional. The customer site, used for password reset links. Default: https://fitnessx.vercel.app
# FITX_SITE_URL=https://fitnessx.vercel.app

# Optional. "on" enables "Send reset email" on People. Leave unset until the README section
# "Password reset emails" is done, or the emailed link will not work.
# FITX_ADMIN_PASSWORD_RESET_EMAILS=on

# Emergency switch only: "1" makes the Content-Security-Policy report-only instead of enforced.
# FITX_ADMIN_CSP_REPORT_ONLY=1
