# Public Supabase client configuration for the existing FITX project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only elevated key. Set one of these in a private local/Vercel environment.
# Prefer the current Supabase secret key; never prefix it with NEXT_PUBLIC_.
# In Vercel: mark it Sensitive and set it for Production only.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative if the current secret key is unavailable.
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Canonical origin. Google sign-in returns here, and in production every other
# host redirects here. Add <origin>/auth/callback to the Supabase Redirect URLs.
# Production: https://fitnessx-admin.vercel.app once that name is added in Vercel
# (until then https://admin-one-blond.vercel.app). Local development: http://localhost:3100
ADMIN_SITE_URL=http://localhost:3100

# Comma-separated Google-account emails allowed into Admin. After Google sign-in the
# account's verified Google email must be on this list, and it is checked again on
# every request. Membership in fitx_admin_members is still required.
FITX_ADMIN_ALLOWED_EMAILS=admin@example.com
